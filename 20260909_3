, BASE_CONNECT_TWOWAY AS (
SELECT SIP, DIP, NSPORT, NDPORT, CNT
  , CONNECT_BY_ROOT(SIP) AS ROOT_SIP
  , CONNECT_BY_ROOT(NSPORT) AS ROOT_SPORT
  , CONNECT_BY_ROOT(DIP) AS ROOT_DIP
  , CONNECT_BY_ROOT(NDPORT) AS ROOT_DPORT
  , LEVEL LV
FROM PKT1M T
START WITH SIP<DIP
CONNECT BY NOCYCLE PRIOR SIP=DIP
           AND PRIOR NSPORT=NDPORT
           AND PRIOR DIP=SIP
           AND PRIOR NDPORT=NSPORT
), BASE_CONNECT_ONEWAY AS (
SELECT SIP, DIP, NSPORT, NDPORT, CNT
  , SIP AS ROOT_SIP, NSPORT AS ROOT_SPORT
  , DIP AS ROOT_DIP, NDPORT AS ROOT_DPORT
  , 1 LV
FROM PKT1M P
WHERE NOT EXISTS (SELECT 1 FROM BASE_CONNECT_TWOWAY T
WHERE T.SIP=P.SIP AND T.DIP=P.DIP AND T.NSPORT=P.NSPORT
AND T.NDPORT=P.NDPORT)
), BASE_CONNECT_UNION AS (
SELECT * FROM BASE_CONNECT_TWOWAY
UNION ALL
SELECT * FROM BASE_CONNECT_ONEWAY )
, BASE_CONNECT_RESULT AS (
SELECT ROOT_SIP SIP
  , ROOT_DIP DIP
  , ROOT_SPORT NSPORT
  , ROOT_DPORT NDPORT
  , SUM(CNT) SUM_CNT
FROM BASE_CONNECT_UNION
GROUP BY ROOT_SIP, ROOT_DIP, ROOT_SPORT, ROOT_DPORT
) SELECT * FROM BASE_CONNECT_RESULT;
